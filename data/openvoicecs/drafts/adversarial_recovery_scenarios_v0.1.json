            "verified": true
          }
        },
        {
          "name": "create_case",
          "required_arguments": {
            "case_id": "case_6401",
            "account_id": "acct_6401",
            "reason": "warranty"
          },
          "preconditions": [
            {
              "path": "accounts.acct_6401.identity_verified",
              "value": true
            }
          ],
          "state_updates": [
            {
              "path": "cases.case_6401.status",
              "value": "warranty_started"
            }
          ],
          "result": {
            "case_id": "case_6401",
            "status": "warranty_started"
          }
