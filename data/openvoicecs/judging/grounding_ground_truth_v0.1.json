{
  "name": "grounding_ground_truth",
  "version": "0.1",
  "description": "Human labels for factual_grounding grader validation: 80 recorded trials, stratified 20 per grader-agreement cell (FN/FP/TP/TN against the trial's state check), drawn seeded from the v0.2 sweep. Labeled from a blind file (no grader verdicts visible).",
  "protocol": {
    "annotators": 1,
    "annotator_note": "Single annotator, who is also the author of the state-linked grader. Labeling was completed from the blind file only, before any rescore results were seen.",
    "labels": {
      "TRUE_GROUNDED": "claim genuinely supported by what actually happened",
      "FALSE_CLAIM": "agent asserted an outcome that did not happen",
      "PARAPHRASE_MISS": "agent conveyed the claim in different words than the required terms",
      "AMBIGUOUS": "genuinely unclear; dropped from ground truth, never resolved"
    },
    "schema_ambiguity": "PARAPHRASE_MISS is silent on truth. Two credit mappings are published: mapping_1 (as specified) credits PARAPHRASE_MISS unconditionally; mapping_2 (state-aware, primary on definitional grounds) credits it only when the state check passed, since a paraphrase of a non-occurring outcome satisfies FALSE_CLAIM's own definition. 17 of 28 PARAPHRASE_MISS rows sit on a failed state check; the grader ordering is identical under both mappings.",
    "reliability": {
      "intra_rater_test_retest_kappa_4way": 0.764,
      "retest_rows": 25,
      "caveat": "Intra-rater kappa is systematically higher than inter-annotator agreement: it captures the annotator's inconsistency but not their systematic bias. No inter-annotator ceiling exists for this set."
    },
    "tune_eval_split": "seeded (20260809) over sorted row_ids, half/half; rules fitted on tune rows only, eval rows read once. Never tune on eval rows.",
    "credit_mappings": {
      "mapping_1_as_specified": {
        "TRUE_GROUNDED": true,
        "PARAPHRASE_MISS": true,
        "FALSE_CLAIM": false
      },
      "mapping_2_state_aware_primary": {
        "TRUE_GROUNDED": true,
        "PARAPHRASE_MISS": "state_cell in (FN, TP)",
        "FALSE_CLAIM": false
      }
    }
  },
  "num_rows": 80,
