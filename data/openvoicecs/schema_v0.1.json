{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvoicecs.org/schema/v0.1.json",
  "title": "OpenVoiceCS-Bench Scenario Suite",
  "type": "object",
  "required": ["name", "version", "scenarios"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "metadata": {"type": "object"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "domain",
        "track",
        "difficulty",
        "customer_goal",
        "initial_state",
        "tools",
        "oracle"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{3}$"},
        "domain": {"type": "string"},
        "track": {
          "type": "string",
          "enum": [
            "text_to_action",
            "audio_to_action",
            "end_to_end_voice",
            "robustness",
            "adversarial_compliance"
          ]
        },
        "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
        "customer_goal": {"type": "string"},
        "customer_profile": {"type": "object"},
        "conversation": {
          "type": "array",
          "items": {"$ref": "#/$defs/message"}
        },
        "initial_state": {"type": "object"},
        "policy": {"type": "object"},
        "tools": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool"}
        },
        "experience": {"type": "object"},
        "oracle": {"$ref": "#/$defs/oracle"},
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["role", "text"],
      "properties": {
        "role": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "required_arguments", "state_updates"],
      "properties": {
        "name": {"type": "string"},
        "required_arguments": {"type": "object"},
        "state_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "value"],
            "properties": {
              "path": {"type": "string"},
              "value": {}
            }
          }
        }
      }
    },
    "tool_call_pattern": {
      "type": "object",
      "required": ["name", "arguments"],
      "properties": {
        "name": {"type": "string"},
        "arguments": {"type": "object"}
      }
    },
    "oracle": {
      "type": "object",
      "required": ["expected_state"],
      "properties": {
        "expected_tool_calls": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool_call_pattern"}
        },
        "forbidden_tool_calls": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool_call_pattern"}
        },
        "required_events": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_events": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected_state": {"type": "object"},
        "reference_response": {"type": "string"}
      }
    }
  }
}
